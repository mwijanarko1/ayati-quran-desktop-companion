{
  "name": "ayati-quran-desktop-companion",
  "version": "0.1.4",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Mikhail Wijanarko",
  "homepage": "https://ayati-website.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwijanarko1/ayati-quran-desktop-companion.git"
  },
  "bugs": {
    "url": "https://github.com/mwijanarko1/ayati-quran-desktop-companion/issues"
  },
  "description": "Ayati - Quran Desktop Companion, a Quran-focused desktop companion for daily reflection",
  "main": "dist/main/main.js",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.mac.identity=null -c.mac.notarize=false -p never",
    "dist:mac:deploy": "npm run dist:mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:icons": "node scripts/build-icons.mjs && electron-icon-builder --input=assets/icon.png --output=assets",
    "start": "electron .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-arm64": "^1.2.4",
    "@img/sharp-win32-arm64": "^0.34.5"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@img/sharp-libvips-win32-x64": "^1.2.4",
    "@img/sharp-win32-x64": "^0.34.5",
    "active-win": "^8.1.0",
    "chokidar": "^3.5.3",
    "chrono-node": "^2.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^8.9.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "jsdom": "24.1.3",
    "msw": "2.4.9",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "1.6.1"
  },
  "build": {
    "appId": "com.ayati.quran-desktop-companion",
    "productName": "Ayati - Quran Desktop Companion",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "icon": "assets/icon.png",
    "npmRebuild": false,
    "mac": {
      "identity": "Mikhail Wijanarko (WH4MT5Z44S)",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": {
        "teamId": "WH4MT5Z44S"
      },
      "extendInfo": {
        "CFBundleDisplayName": "Ayati",
        "NSScreenCaptureUsageDescription": "Ayati does not use screen capture for Quran reflections.",
        "NSAppleEventsUsageDescription": "Ayati needs this to detect which app you're using."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "assets/qul",
        "to": "assets/qul"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://ayati-website.vercel.app/update/electron"
    }
  },
  "trustedDependencies": [
    "active-win",
    "electron",
    "sharp",
    "@img"
  ]
}
