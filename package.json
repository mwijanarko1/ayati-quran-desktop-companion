{
  "name": "ayati-quran-desktop-companion",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Mikhail Wijanarko",
  "description": "Ayati - Quran Desktop Companion, a Quran-focused screen companion powered by OpenRouter",
  "main": "dist/main/main.js",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "concurrently \"bun run dev:main\" \"bun run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "bun run build:renderer && bun run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:mac:deploy": "bun run dist:mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux",
    "build:icons": "bun scripts/build-icons.mjs && electron-icon-builder --input=assets/icon.png --output=assets",
    "start": "electron .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "active-win": "^8.1.0",
    "chokidar": "^3.5.3",
    "dotenv": "^17.3.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "jsdom": "24.1.3",
    "msw": "2.4.9",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "1.6.1"
  },
  "build": {
    "appId": "com.ayati.quran-desktop-companion",
    "productName": "Ayati - Quran Desktop Companion",
    "icon": "assets/icon.png",
    "mac": {
      "identity": "Yuwen Wu (39428U49B4)",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": {
        "teamId": "39428U49B4"
      },
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Ayati - Quran Desktop Companion needs screen capture permission to suggest Quran reflections for what is on your screen.",
        "NSAppleEventsUsageDescription": "Ayati - Quran Desktop Companion needs this to detect which app you're using."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/mwijanarko1/ayati-quran-desktop-companion/releases/latest/download"
    }
  },
  "trustedDependencies": [
    "active-win"
  ]
}
