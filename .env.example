# Copy to `.env.local` and fill in secrets (`.env.local` is gitignored).
#
# Development server port (default: 5173)
VITE_DEV_PORT=5173

# OpenAI API key (optional, no longer required for screenshot analysis)
# OPENAI_API_KEY=your-openai-api-key-here

# Quran Foundation API configuration
# Request access: https://api-docs.quran.foundation/request-access
QURAN_CLIENT_ID=your-quran-foundation-client-id
QURAN_CLIENT_SECRET=your-quran-foundation-client-secret
QURAN_REDIRECT_URI=ayahlens://oauth/callback
# Use "prelive" for pre-production credentials, omit or set "production" for production.
QURAN_FOUNDATION_ENV=prelive
